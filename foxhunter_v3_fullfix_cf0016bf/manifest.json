{
  "manifest_version": 3,
  "name": "银狐猎手 · 智能威胁防御系统",
  "version": "0.6.0",
  "description": "基于多层行为指纹识别与动态启发式分析引擎的新一代下载安全护盾",
  "author": "FoxHunter Team",
  "permissions": [
    "downloads",
    "webRequest",
    "storage",
    "activeTab",
    "notifications",
    "tabs",
    "webNavigation",
    "debugger",
    "dns"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content_script.js"
      ],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "银狐猎手 · 安全态势感知",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_page": "options.html",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": ["config.json", "redirect-warning.html", "redirect-warning.js"],
      "matches": ["<all_urls>"]
    }
  ]
}
