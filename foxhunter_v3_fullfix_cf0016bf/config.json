  "settings": {
    "ball": {
      "enabled": true,
      "safeColor": "#10b981",
      "warningColor": "#f59e0b",
      "dangerColor": "#ef5350",
      "safeThreshold": 50,
      "dangerThreshold": 100,
      "size": 56,
      "opacity": 0.8
    },
    "popup": {
      "enabled": true
    },
    "redirect": {
      "enabled": true
    },
    "downloadHook": {
      "enabled": true
    },
    "ssl": {
      "enabled": true
    },
    "scanInterval": 3,
    "dnsCheck": true,
    "dnsServer": "auto",
    "silentDuration": 3600,
    "popupCooldown": 3600,
    "theme": "dark",
    "notification": true,
    "sound": false,
    "rules": {
      "domainSpoof": true,
      "archiveDownload": true,
      "icpCheck": true,
      "linkAnalysis": true,
      "codeEngineering": true,
      "downloadIntercept": true,
      "emojiDensity": true,
      "siteHijack": true
    }
  }
}
